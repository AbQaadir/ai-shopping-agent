# Kapuruka — .dockerignore for Railway Docker builds
# Keeps the build context small and prevents secrets from leaking into the image.

# Local dev only
.env
.env.local
.env.*.local
.venv

# Next.js build artifacts (rebuilt inside Docker)
.next
out

# Node modules (reinstalled inside Docker)
node_modules

# Git
.git
.gitignore

# Local Docker setup (not needed in Railway)
docker-compose.yml
Dockerfile.migration

# Dev tooling
research
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*

# TypeScript build info
*.tsbuildinfo
