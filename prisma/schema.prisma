datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Supplier {
  id              String    @id @default(uuid())
  name            String
  countryCode     String
  yearsOnPlatform Int
  reorderRate     Float
  rating          Float
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title             String
  priceRange        String
  minOrderQuantity  Int
  salesVolume       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Sourcing Task")
  status    String        @default("active") // active, archived
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String      @id @default(uuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String      // user, assistant
  content        String
  thoughtProcess Json?       // Native PostgreSQL JSON type
  products       Json?       // Native PostgreSQL JSON type
  createdAt      DateTime    @default(now())
}
