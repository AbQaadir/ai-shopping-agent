datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id              String        @id @default(uuid())
  email           String        @unique
  name            String
  phone           String?       // e.g. "+94771234567"
  addresses       Json?         // UserAddress[] — categorized saved delivery addresses
  profileComplete Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chatSessions    ChatSession[]
  orders          Order[]
  cart            Json?
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      // completed, pending, cancelled
  totalLKR        Float
  kaprukaRef      String?     // order_ref returned by kapruka_create_order MCP tool
  deliveryDate    String?     // YYYY-MM-DD delivery date chosen by user
  personalMessage String?     // optional gift_message passed to kapruka_create_order
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   // Kapruka product catalog ID
  productName String
  quantity    Int
  priceLKR    Float
  imageUrl    String?
}

model ChatSession {
  id                String           @id @default(uuid())
  title             String           @default("New Sourcing Task")
  status            String           @default("active") // active, archived
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages          ChatMessage[]
  checkoutSession   CheckoutSession?
  harnessEvalLogs   HarnessEvalLog[]

  // ── Harness: Session Initializer ────────────────────────────────────────
  // Structured context document generated by the Session Initializer on the
  // first message of a session. Used by all agents to understand session goal.
  sessionContext    Json?            // SessionContext — see src/lib/harness/types.ts

  // ── Harness: Context Compactor ──────────────────────────────────────────
  // LLM-generated summary of the conversation history for long sessions.
  // Re-generated every ~5 new messages. Replaces raw historySnippet.
  compactedHistory  String?          // Bullet-point conversation summary
  compactedAt       DateTime?        // When the summary was last generated

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

/// Active checkout state for a chat session.
/// Single source of truth — replaces walking thoughtProcess.orderFlowStep across messages.
/// Created on checkout_start, updated on each phase transition, deleted on confirmed/cancelled.
model CheckoutSession {
  id               String      @id @default(uuid())
  chatSessionId    String      @unique
  chatSession      ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  // Current checkout phase
  // qty_ask | delivery_ask | new_address_form | delivery_date_ask | payment_ask | confirmed | cancelled
  phase            String

  // Cart items for this session (always live/current)
  cartItems        Json        // CartItem[]

  // Single-product checkout (non-cart flow)
  product          Json?       // InlineProduct

  // Accumulated data as user progresses
  confirmedQty     Int?
  confirmedAddress Json?       // { name, phone, address, city }
  savedAddress     Json?       // user default address loaded at checkout start
  geocodedLocation Json?       // { lat, lng, formattedAddress, label }
  paymentMethod    String?     // "cod" | "card"
  deliveryDate     String?     // YYYY-MM-DD — chosen by user in delivery_date_ask phase
  personalMessage  String?     // optional gift message — passed to kapruka_create_order
  deliveryFeeLKR   Float?      // flat rate delivery fee returned by kapruka_check_delivery

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ChatMessage {
  id             String      @id @default(uuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String      // user, assistant
  content        String
  thoughtProcess Json?       // Native PostgreSQL JSON type
  products       Json?       // Native PostgreSQL JSON type
  createdAt      DateTime    @default(now())
}

/// Harness Engineering Evaluation Log
/// Records every generator-evaluator decision for observability and prompt tuning.
/// Evaluator types: "search_evaluator" | "response_evaluator" | "checkout_contract"
model HarnessEvalLog {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Which message triggered this evaluation
  messageId     String

  // Which harness component ran this evaluation
  evaluatorType String      // "search_evaluator" | "response_evaluator" | "checkout_contract"

  // Evaluation result
  score         Float       // 0.0-10.0 weighted score
  passed        Boolean     // true if score >= threshold
  feedback      String?     // The evaluator's critique (used for regeneration)
  regenerated   Boolean     @default(false) // Did we trigger a regeneration?

  // Performance tracking
  latencyMs     Int         // Wall-clock time this evaluator took

  // Extra context (phase for contracts, query for search, intent for response)
  context       Json?       // Arbitrary JSON context for this eval type

  createdAt     DateTime    @default(now())

  @@index([sessionId])
  @@index([evaluatorType])
  @@index([createdAt])
}
