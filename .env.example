# ============================================================
# Kapuruka AI Agent — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# Set ALL of these in the Railway service Variables tab.
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Transaction/pooler URL — used by Prisma at runtime (pgbouncer=true for connection pooling)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL — used by Prisma for migrations (bypasses pgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth & SDK ---
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# --- Gemini API ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model names (use exact model IDs from Google AI Studio)
# Fast/cheap model for intent classification and suggestions
FAST_GEMINI_MODEL="gemini-2.0-flash-lite"
# Main reasoning model for full response generation
REASONING_GEMINI_MODEL="gemini-2.5-flash"
# Fast autocomplete model for next-phrase query suggestion
AUTO_COMPLETE_LLM="gemini-2.0-flash-lite"

# --- Google Maps ---
# Obtain from: https://console.cloud.google.com -> APIs -> Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# --- Kapruka MCP Server ---
# Public MCP endpoint — no API key required for this server.
# Rate limits: 60 req/min general, 30 order-creates/hr.
KAPRUKA_MCP_URL="https://mcp.kapruka.com/mcp"

# Timeout for each MCP tool call in milliseconds (default: 10000 = 10s)
KAPRUKA_MCP_TIMEOUT_MS="10000"

# --- Public Site URL ---
# Set this to your Railway-generated domain after first deploy, e.g.:
# NEXT_PUBLIC_SITE_URL="https://kapuruka-agent.up.railway.app"
NEXT_PUBLIC_SITE_URL="https://your-app.up.railway.app"
