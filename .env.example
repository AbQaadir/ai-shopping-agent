# ============================================================
# Kapuruka AI Agent — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (Local Docker PostgreSQL) ---
# Used for chat session and message persistence only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kapuruka?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kapuruka?schema=public"

# --- Gemini API ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model names (use exact model IDs from Google AI Studio)
# Fast/cheap model for intent classification and suggestions
FAST_GEMINI_MODEL="gemini-3.1-flash-lite"
# Main reasoning model for full response generation
REASONING_GEMINI_MODEL="gemini-3.5-flash"
# Fast autocomplete model for next-phrase query suggestion
AUTO_COMPLETE_LLM="gemini-3.1-flash-lite"

# --- Kapruka MCP Server ---
# Public MCP endpoint — no API key required for this server.
# Rate limits: 60 req/min general, 30 order-creates/hr.
KAPRUKA_MCP_URL="https://mcp.kapruka.com/mcp"

# Timeout for each MCP tool call in milliseconds (default: 10000 = 10s)
KAPRUKA_MCP_TIMEOUT_MS="10000"
